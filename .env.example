# Com `docker compose up -d db` use a porta 5433 (ver docker-compose.yml).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/gaius?schema=public"
JWT_SECRET="gaius-project-top-secret-key-for-jwt-token-generation-and-authentication-in-production-use-long-random-string"
REDIS_URL="redis://localhost:6379"
PORT=8080

# Origens do frontend (separadas por vírgula)
CORS_ORIGIN=http://localhost:3000

# Google OAuth (mesmo Client ID do NextAuth no gaius-web)
GOOGLE_CLIENT_ID="cole_seu_google_client_id_aqui"

# brapi.dev — https://brapi.dev/dashboard
BRAPI_TOKEN="cole_sua_chave_aqui"
# Plano gratuito: 1 ticker por request (não altere se for seu caso)
BRAPI_MAX_TICKERS_PER_REQUEST=1
# Delay entre requests no sync em lote (ms)
BRAPI_REQUEST_DELAY_MS=350
# 0 = todos os tickers de /available no POST /assets/sync (só lista, sem cotação)
# Use POST /assets/PETR4/sync para detalhes de 1 ativo
BRAPI_CATALOG_SYNC_LIMIT=0
# Máx. ativos atualizados pelo cron a cada minuto
BRAPI_CRON_QUOTE_LIMIT=30
